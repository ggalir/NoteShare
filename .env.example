# Shared JWT
# Generate a secure base64 secret: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# RabbitMQ (default guest credentials work with the rabbitmq Docker image)
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Auth service DB
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=secret

# Notes service DB
NOTES_DB_USERNAME=postgres
NOTES_DB_PASSWORD=secret

# Sharing service DB
SHARING_DB_USERNAME=postgres
SHARING_DB_PASSWORD=secret

# Mailer SMTP
# Local dev (Mailtrap sandbox):
#   MAIL_HOST=sandbox.smtp.mailtrap.io  MAIL_PORT=2525
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# Local dev:  http://localhost:3000/verify
# Production: https://yourdomain.com/verify
AUTH_VERIFY_URL=