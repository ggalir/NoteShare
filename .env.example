# Shared JWT
# Generate a secure base64 secret: openssl rand -base64 48
JWT_SECRET=your_base64_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# RabbitMQ (default guest credentials work with the rabbitmq Docker image)
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Auth service DB
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=secret

# Notes service DB
NOTES_DB_USERNAME=postgres
NOTES_DB_PASSWORD=secret

# Sharing service DB
SHARING_DB_USERNAME=postgres
SHARING_DB_PASSWORD=secret

# Mailer — get credentials from https://mailtrap.io (free sandbox)
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password